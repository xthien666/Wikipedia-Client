<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_gutter"
    android:paddingEnd="@dimen/page_gutter">

    <!-- Reading rhythm (Stitch history header); numbers are computed from real history. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_reading_rhythm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/primary_container"
        app:cardCornerRadius="@dimen/card_radius_large"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_rhythm_title"
                android:textAppearance="@style/TextAppearance.WikiRead.Overline"
                android:textColor="@color/secondary_fixed_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.WikiRead.HistoryStat">
                    <TextView android:id="@+id/tv_stat_today" style="@style/Widget.WikiRead.HistoryStatValue" />
                    <TextView style="@style/Widget.WikiRead.HistoryStatLabel" android:text="@string/history_stat_today" />
                </LinearLayout>

                <View style="@style/Widget.WikiRead.HistoryStatDivider" />

                <LinearLayout style="@style/Widget.WikiRead.HistoryStat">
                    <TextView android:id="@+id/tv_stat_week" style="@style/Widget.WikiRead.HistoryStatValue" />
                    <TextView style="@style/Widget.WikiRead.HistoryStatLabel" android:text="@string/history_stat_week" />
                </LinearLayout>

                <View style="@style/Widget.WikiRead.HistoryStatDivider" />

                <LinearLayout style="@style/Widget.WikiRead.HistoryStat">
                    <TextView android:id="@+id/tv_stat_total" style="@style/Widget.WikiRead.HistoryStatValue" />
                    <TextView style="@style/Widget.WikiRead.HistoryStatLabel" android:text="@string/history_stat_total" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_history_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/history_saved_count"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:text="@string/history_clear_all"
            android:textColor="@color/error"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_trash_small"
            app:drawableTint="@color/error" />
    </LinearLayout>

    <com.example.wikipediaclient.ui.common.StatusView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>