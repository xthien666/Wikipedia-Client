<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- StatusView for empty state -->


        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Saved-article notice -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_gutter"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/page_gutter"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" android:baselineAligned="false"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_secondary"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_bookmark"
                        app:tint="@color/secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bookmark_banner_title"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/bookmark_network_notice"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingStart="@dimen/page_gutter"
                android:paddingEnd="@dimen/page_gutter"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false">

                    <TextView android:focusable="true" android:clickable="true"
                        android:id="@+id/chip_fav_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:minHeight="48dp"
                        android:background="@drawable/bg_pill_dark"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/bookmark_all"
                        android:textColor="@color/on_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView android:focusable="true" android:clickable="true"
                        android:id="@+id/chip_fav_places"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:minHeight="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_light"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/bookmark_places"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />

                    <TextView android:focusable="true" android:clickable="true"
                        android:id="@+id/chip_fav_science"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:minHeight="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_light"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/bookmark_science"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

        <com.example.wikipediaclient.ui.common.StatusView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/page_gutter"
            android:visibility="gone" />

            <!-- Reuses the original card layout for each stored article. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bookmark_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Reading Habit Card at Bottom -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_gutter"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/page_gutter"
                app:cardBackgroundColor="@color/badge_bg"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" android:baselineAligned="false"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_pill_dark"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_book"
                        app:tint="@color/on_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bookmark_habit_title"
                            android:textColor="@color/on_secondary_container"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bookmark_habit_message"
                            android:textColor="@color/secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
