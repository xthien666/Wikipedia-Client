<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="@dimen/page_gutter"
    android:paddingEnd="@dimen/page_gutter" android:paddingTop="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/bookmark_network_notice" android:textSize="14sp"
        android:textColor="@color/on_surface_variant" android:paddingBottom="12dp" />
    <TextView android:id="@+id/bookmark_count" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
        android:textColor="@color/primary" android:paddingBottom="12dp" />
    <com.example.wikipediaclient.ui.common.StatusView android:id="@+id/status"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/bookmark_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="24dp" />
</LinearLayout>
