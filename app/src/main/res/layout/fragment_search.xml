<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Search Input Bar (Stitch design) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/page_gutter"
        android:background="@drawable/bg_search_bar"
        android:elevation="1dp"
        android:paddingStart="14dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/outline" />

            <EditText
                android:id="@+id/query_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/query_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_query"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/outline" />

            <ImageButton
                android:id="@+id/btn_voice_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_search"
                android:src="@drawable/ic_mic"
                app:tint="@color/secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Topic Filter Chips (Horizontal Scroll); the selected chip is dark. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_history"
                style="@style/Widget.WikiRead.TopicChip"
                android:text="@string/topic_history" />

            <TextView
                android:id="@+id/chip_places"
                style="@style/Widget.WikiRead.TopicChip"
                android:layout_marginStart="8dp"
                android:text="@string/topic_places" />

            <TextView
                android:id="@+id/chip_science"
                style="@style/Widget.WikiRead.TopicChip"
                android:layout_marginStart="8dp"
                android:text="@string/topic_science" />

            <TextView
                android:id="@+id/chip_arts"
                style="@style/Widget.WikiRead.TopicChip"
                android:layout_marginStart="8dp"
                android:text="@string/topic_arts" />

            <TextView
                android:id="@+id/chip_nature"
                style="@style/Widget.WikiRead.TopicChip"
                android:layout_marginStart="8dp"
                android:text="@string/topic_nature" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <com.example.wikipediaclient.ui.common.StatusView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- Featured Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:fontFamily="serif"
                        android:text="@string/featured_today"
                        android:textColor="@color/primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_secondary"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/updated_daily"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Featured Card: Văn Miếu - Quốc Tử Giám, with its real Wikipedia lead image -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_featured"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="@dimen/card_radius_large"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="196dp">

                            <ImageView
                                android:id="@+id/img_featured"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_hero_placeholder"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="96dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_scrim_bottom" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_dark"
                                    android:paddingStart="10dp"
                                    android:paddingTop="4dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="4dp"
                                    android:text="@string/featured_badge"
                                    android:textColor="@color/on_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_dark"
                                    android:baselineAligned="false"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="8dp"
                                    android:paddingTop="4dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="4dp">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_schedule"
                                        app:tint="@color/on_primary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="@string/featured_read_time"
                                        android:textColor="@color/on_primary"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:text="@string/featured_title"
                                android:textColor="@color/primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:lineSpacingExtra="3dp"
                                android:maxLines="3"
                                android:text="@string/featured_snippet"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_pill_dark"
                                    android:fontFamily="serif"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:text="@string/ui_fragment_search_2"
                                    android:textColor="@color/on_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/featured_tag"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp" />

                                <!-- open_sample button retained for TV1 day 1 integration compatibility -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/open_sample"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="12dp"
                                    android:text="@string/sample_action"
                                    android:textSize="13sp"
                                    app:icon="@drawable/ic_arrow_forward"
                                    app:iconGravity="end"
                                    app:iconSize="16dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Knowledge Tip -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    app:cardBackgroundColor="@color/badge_bg"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_pill_dark"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_tips"
                            app:tint="@color/on_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tip_title"
                                android:textColor="@color/on_secondary_container"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/tip_body"
                                android:textColor="@color/secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Suggested Articles header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_book"
                        app:tint="@color/secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:fontFamily="serif"
                        android:text="@string/suggested_articles"
                        android:textColor="@color/primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Suggested Item 1: Phố cổ Hội An -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_article_1"
                    style="@style/Widget.WikiRead.SuggestionCard"
                    android:layout_marginTop="12dp">

                    <LinearLayout style="@style/Widget.WikiRead.SuggestionRow">

                        <com.google.android.material.card.MaterialCardView style="@style/Widget.WikiRead.Thumb">

                            <ImageView
                                android:id="@+id/img_article_1"
                                style="@style/Widget.WikiRead.ThumbImage" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout style="@style/Widget.WikiRead.SuggestionText">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/card_1_category"
                                    android:textAppearance="@style/TextAppearance.WikiRead.Overline" />

                                <TextView
                                    style="@style/Widget.WikiRead.ReadTime"
                                    android:text="@string/card_1_time" />
                            </LinearLayout>

                            <TextView
                                style="@style/Widget.WikiRead.SuggestionTitle"
                                android:text="@string/card_1_title" />

                            <TextView
                                style="@style/Widget.WikiRead.SuggestionSnippet"
                                android:text="@string/card_1_snippet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Suggested Item 2: Đồng bằng sông Cửu Long -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_article_2"
                    style="@style/Widget.WikiRead.SuggestionCard"
                    android:layout_marginTop="10dp">

                    <LinearLayout style="@style/Widget.WikiRead.SuggestionRow">

                        <com.google.android.material.card.MaterialCardView style="@style/Widget.WikiRead.Thumb">

                            <ImageView
                                android:id="@+id/img_article_2"
                                style="@style/Widget.WikiRead.ThumbImage" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout style="@style/Widget.WikiRead.SuggestionText">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/card_2_category"
                                    android:textAppearance="@style/TextAppearance.WikiRead.Overline" />

                                <TextView
                                    style="@style/Widget.WikiRead.ReadTime"
                                    android:text="@string/card_2_time" />
                            </LinearLayout>

                            <TextView
                                style="@style/Widget.WikiRead.SuggestionTitle"
                                android:text="@string/card_2_title" />

                            <TextView
                                style="@style/Widget.WikiRead.SuggestionSnippet"
                                android:text="@string/card_2_snippet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Suggested Item 3: Chùa Một Cột -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_article_3"
                    style="@style/Widget.WikiRead.SuggestionCard"
                    android:layout_marginTop="10dp">

                    <LinearLayout style="@style/Widget.WikiRead.SuggestionRow">

                        <com.google.android.material.card.MaterialCardView style="@style/Widget.WikiRead.Thumb">

                            <ImageView
                                android:id="@+id/img_article_3"
                                style="@style/Widget.WikiRead.ThumbImage" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout style="@style/Widget.WikiRead.SuggestionText">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/card_3_category"
                                    android:textAppearance="@style/TextAppearance.WikiRead.Overline" />

                                <TextView
                                    style="@style/Widget.WikiRead.ReadTime"
                                    android:text="@string/card_3_time" />
                            </LinearLayout>

                            <TextView
                                style="@style/Widget.WikiRead.SuggestionTitle"
                                android:text="@string/card_3_title" />

                            <TextView
                                style="@style/Widget.WikiRead.SuggestionSnippet"
                                android:text="@string/card_3_snippet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_load_more"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginEnd="@dimen/page_gutter"
        android:layout_marginBottom="8dp"
        android:minHeight="48dp"
        android:text="@string/search_load_more"
        android:visibility="gone" />
</LinearLayout>
