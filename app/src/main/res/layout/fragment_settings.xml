<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- SECTION 1: Đọc bài -->
        <TextView
            style="@style/Widget.WikiRead.SettingsHeader"
            android:text="@string/settings_section_reading" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WikiRead.SettingsGroup">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.WikiRead.SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_font_size" />

                    <TextView
                        android:id="@+id/tv_font_badge"
                        style="@style/Widget.WikiRead.SettingsValue"
                        android:text="@string/settings_font_badge" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.WikiRead.SettingsSummary"
                    android:text="@string/ui_fragment_settings_1" />

                <!-- Standard Material 3 segmented buttons; selection is also mirrored via isSelected(). -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/font_size_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_small"
                        style="@style/Widget.WikiRead.FontSegment"
                        android:text="@string/font_small"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_normal"
                        style="@style/Widget.WikiRead.FontSegment"
                        android:text="@string/font_normal"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_large"
                        style="@style/Widget.WikiRead.FontSegment"
                        android:text="@string/font_large"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_huge"
                        style="@style/Widget.WikiRead.FontSegment"
                        android:text="@string/font_huge"
                        android:textSize="16sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Live preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_preview"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_card_title"
                        android:textColor="@color/outline"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="serif"
                        android:text="@string/preview_card_headline"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_preview_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="serif"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/preview_card_quote"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: Ngôn ngữ và dữ liệu -->
        <TextView
            style="@style/Widget.WikiRead.SettingsHeader"
            android:text="@string/settings_section_lang" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WikiRead.SettingsGroup">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Language row -->
                <LinearLayout style="@style/Widget.WikiRead.SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Widget.WikiRead.SettingsTitle" android:text="@string/settings_lang" />
                        <TextView style="@style/Widget.WikiRead.SettingsSummary" android:text="@string/settings_lang_sub" />
                    </LinearLayout>

                    <TextView
                        style="@style/Widget.WikiRead.SettingsValue"
                        android:layout_marginStart="16dp"
                        android:text="@string/settings_lang_value" />
                </LinearLayout>

                <View style="@style/Widget.WikiRead.SettingsDivider" />

                <!-- Cache row -->
                <LinearLayout
                    style="@style/Widget.WikiRead.SettingsRow"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Widget.WikiRead.SettingsTitle" android:text="@string/settings_cache" />
                        <TextView style="@style/Widget.WikiRead.SettingsSummary" android:text="@string/settings_cache_sub" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_cache_val"
                        style="@style/Widget.WikiRead.SettingsValue"
                        android:text="@string/settings_cache_val" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_cache"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="48dp"
                        android:text="@string/settings_cache_clear" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: Giới thiệu -->
        <TextView
            style="@style/Widget.WikiRead.SettingsHeader"
            android:text="@string/settings_section_about" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.WikiRead.SettingsGroup">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Widget.WikiRead.SettingsBlock">
                    <TextView style="@style/Widget.WikiRead.SettingsTitle" android:text="@string/settings_version" />
                    <TextView android:id="@+id/tv_version" style="@style/Widget.WikiRead.SettingsSummary" android:text="@string/app_name" />
                </LinearLayout>

                <View style="@style/Widget.WikiRead.SettingsDivider" />

                <LinearLayout style="@style/Widget.WikiRead.SettingsBlock">
                    <TextView style="@style/Widget.WikiRead.SettingsTitle" android:text="@string/settings_team" />
                    <TextView android:id="@+id/tv_team_details" style="@style/Widget.WikiRead.SettingsSummary" android:text="@string/settings_team_val" />
                </LinearLayout>

                <View style="@style/Widget.WikiRead.SettingsDivider" />

                <LinearLayout style="@style/Widget.WikiRead.SettingsBlock">
                    <TextView style="@style/Widget.WikiRead.SettingsTitle" android:text="@string/settings_license" />
                    <TextView style="@style/Widget.WikiRead.SettingsSummary" android:text="@string/settings_license_val" />
                </LinearLayout>

                <View style="@style/Widget.WikiRead.SettingsDivider" />

                <LinearLayout style="@style/Widget.WikiRead.SettingsBlock">
                    <TextView style="@style/Widget.WikiRead.SettingsTitle" android:text="@string/about_app_license_title" />
                    <TextView android:id="@+id/tv_app_license" style="@style/Widget.WikiRead.SettingsSummary" android:text="@string/about_app_license_value" />
                </LinearLayout>

                <View style="@style/Widget.WikiRead.SettingsDivider" />

                <!-- External links: plain left-aligned rows with an "open" glyph. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_about_source"
                    style="@style/Widget.WikiRead.SettingsLink"
                    android:text="@string/settings_source_val" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_about_terms"
                    style="@style/Widget.WikiRead.SettingsLink"
                    android:text="@string/about_terms" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_about_project"
                    style="@style/Widget.WikiRead.SettingsLink"
                    android:layout_marginBottom="4dp"
                    android:text="@string/about_project" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_disclaimer"
            android:textColor="@color/outline"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
