<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.WikiRead.SuggestionCard"
    android:layout_marginTop="10dp">

    <LinearLayout
        style="@style/Widget.WikiRead.SuggestionRow"
        android:minHeight="48dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WikiRead.Thumb"
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/result_thumbnail"
                style="@style/Widget.WikiRead.ThumbImage" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            style="@style/Widget.WikiRead.SuggestionText"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/result_title"
                style="@style/Widget.WikiRead.SuggestionTitle"
                android:layout_marginTop="0dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/result_snippet"
                style="@style/Widget.WikiRead.SuggestionSnippet"
                android:layout_marginTop="4dp"
                android:maxLines="3" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
