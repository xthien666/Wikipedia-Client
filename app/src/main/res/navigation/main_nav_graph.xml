<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_navigation" app:startDestination="@id/searchFragment">
    <fragment android:id="@+id/searchFragment"
        android:name="com.example.wikipediaclient.ui.search.SearchFragment" android:label="@string/nav_search" />
    <fragment android:id="@+id/libraryFragment"
        android:name="com.example.wikipediaclient.ui.library.LibraryFragment" android:label="@string/nav_library" />
    <fragment android:id="@+id/historyFragment"
        android:name="com.example.wikipediaclient.ui.history.HistoryFragment" android:label="@string/nav_history" />
    <fragment android:id="@+id/settingsFragment"
        android:name="com.example.wikipediaclient.ui.settings.SettingsFragment" android:label="@string/nav_settings" />
    <fragment android:id="@+id/articleFragment"
        android:name="com.example.wikipediaclient.ui.article.ArticleFragment" android:label="@string/nav_article">
        <argument android:name="title" app:argType="string" />
        <argument android:name="language" app:argType="string" android:defaultValue="vi" />
        <argument android:name="pageId" app:argType="long" android:defaultValue="0L" />
    </fragment>
    <action android:id="@+id/action_open_article" app:destination="@id/articleFragment" />
</navigation>
